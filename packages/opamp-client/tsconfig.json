{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "lib": ["es2022"],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "rootDir": "lib",
    "outDir": "types"
  },
  "include": ["lib"]
}
